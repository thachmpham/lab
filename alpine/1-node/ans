# Set keyman layout
KEYMAPOPTS="us us"

# Set hostname
HOSTNAMEOPTS=vm

# Set device manager to mdev
DEVDOPTS=mdev

# Contents of /etc/network/interfaces
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
hostname vm1

auto eth1
iface eth1 inet static
    address 191.0.0.10/24

auto eth2
iface eth2 inet static
    address 192.0.0.10/24

auto eth3
iface eth3 inet static
    address 193.0.0.10/24
"

# Set DNS
# DNSOPTS="-d example.com 8.8.8.8"

# Set timezone
TIMEZONEOPTS="Asia/Ho_Chi_Minh"

# set http/ftp proxy
PROXYOPTS=none

# Add first mirror (CDN)
APKREPOSOPTS="-1"

# Setup user
USEROPTS="no"

# Install Openssh
SSHDOPTS=openssh

# Set NTP
NTPOPTS="openntpd"

# Setup disk
DISKOPTS="-m sys /dev/sda"

# Set disk label
LBUOPTS=none

# setup cache
APKCACHEOPTS=none